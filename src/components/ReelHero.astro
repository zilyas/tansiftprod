---
import { heroReel } from '../data/media';
import { embedUrl, videoType } from '../lib/media';
import { path, type Lang } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
  eyebrow: string;
  title: string;
  lede: string;
}

const { lang, eyebrow, title, lede } = Astro.props;
const tr = t(lang);
const { video, videoFallback, poster, fullReelUrl } = heroReel;
// The hero loop must be a video file (WebM, with an optional MP4 fallback for older iPhones).
const loop = video && !embedUrl(video) ? video : '';
---

<section class="hero band tone-cobalt" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <div class="hero__title">
      <p class="label label--accent">{eyebrow}</p>
      <h1 id="hero-title">{title}</h1>
    </div>
    <div class="hero__body">
      <p class="lede">{lede}</p>
      <div class="btn-row">
        <a class="btn" href={path('contact', lang)}>{tr('nav.cta')}</a>
        {
          fullReelUrl ? (
            <a class="btn btn--ghost" href={fullReelUrl} target="_blank" rel="noopener">
              <svg class="i-play" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M4 2.5v11l9-5.5z" fill="currentColor"/></svg>
              {tr('cta.reel')}
            </a>
          ) : (
            <a class="btn btn--ghost" href={path('work', lang)}>
              {tr('cta.work')}
            </a>
          )
        }
      </div>
    </div>

    <div class="hero__frame frame frame--scope">
      {
        loop ? (
          <video
            class="hero__video"
            poster={poster.src}
            muted
            loop
            playsinline
            preload="none"
            aria-label={poster.alt[lang]}
            data-autoplay
          >
            <source src={loop} type={videoType(loop)} />
            {videoFallback && <source src={videoFallback} type={videoType(videoFallback)} />}
          </video>
        ) : (
          <img
            src={poster.src}
            alt={poster.alt[lang]}
            width={poster.width}
            height={poster.height}
            fetchpriority="high"
            decoding="async"
          />
        )
      }
      <div class="hero__hud" aria-hidden="true">
        <span>SC.01 · Essaouira</span>
        <span class="hero__tc">TC 00:00:00:00</span>
      </div>
      <span class="corner c1" aria-hidden="true"></span>
      <span class="corner c2" aria-hidden="true"></span>
      <span class="corner c3" aria-hidden="true"></span>
      <span class="corner c4" aria-hidden="true"></span>
      {poster.placeholder && <span class="sample-badge">{tr('media.sample')}</span>}
      {
        loop && (
          <button class="hero__pause" type="button" aria-pressed="false" data-pause={tr('media.pause')} data-play={tr('media.play')}>
            <svg class="i-pause" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M4 2.5h3v11H4zM9 2.5h3v11H9z" fill="currentColor"/></svg><svg class="i-play" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M4 2.5v11l9-5.5z" fill="currentColor"/></svg>
            <span class="visually-hidden">{tr('media.pause')}</span>
          </button>
        )
      }
    </div>
  </div>
  <div class="strip" aria-hidden="true"></div>
</section>

<style>
  .hero.band {
    padding-block: clamp(var(--s-4), 6vw, var(--s-6)) 0;
    display: grid;
    gap: var(--s-5);
  }

  /* Phones: title, then the reel, then the pitch, so the work is in the
     first screen. Wide screens: title and pitch side by side above the reel. */
  .hero__inner {
    display: grid;
    gap: var(--s-4);
    grid-template-areas:
      'title'
      'frame'
      'body';
  }

  .hero__title {
    grid-area: title;
    display: grid;
    gap: var(--s-2);
  }

  .hero__body {
    grid-area: body;
    display: grid;
    gap: var(--s-3);
    align-content: end;
  }

  .hero__frame {
    grid-area: frame;
  }

  .hero__title h1 {
    max-width: 14ch;
  }

  @media (max-width: 600px) {
    .hero__title h1 {
      font-size: clamp(2.4rem, 11.5vw, 3.4rem);
    }
  }

  @media (min-width: 900px) {
    .hero__title h1 {
      font-size: clamp(3rem, 6.4vw, 6rem);
      max-width: 13ch;
    }

    .hero__inner {
      grid-template-columns: 1.25fr 1fr;
      grid-template-areas:
        'title body'
        'frame frame';
      column-gap: var(--s-6);
    }
  }

  .hero__frame {
    position: relative;
  }

  /* Letterbox bars */
  .hero__frame::before,
  .hero__frame::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    height: 7%;
    background: #050b17;
    z-index: 1;
    pointer-events: none;
  }

  .hero__frame::before {
    top: 0;
  }

  .hero__frame::after {
    bottom: 0;
  }

  .hero__hud {
    position: absolute;
    inset: 9% 3% auto 3%;
    display: flex;
    justify-content: space-between;
    gap: 8px;
    z-index: 2;
    font: 400 clamp(0.6rem, 1.5vw, 0.78rem) / 1 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--washed);
    text-shadow: 0 1px 3px #000;
    font-variant-numeric: tabular-nums;
  }

  .corner {
    position: absolute;
    width: 18px;
    height: 18px;
    border: 1.5px solid rgb(244 242 237 / 0.8);
    z-index: 2;
  }

  .c1 { top: 10%; left: 2%; border-right: 0; border-bottom: 0; }
  .c2 { top: 10%; right: 2%; border-left: 0; border-bottom: 0; }
  .c3 { bottom: 10%; left: 2%; border-right: 0; border-top: 0; }
  .c4 { bottom: 10%; right: 2%; border-left: 0; border-top: 0; }

  .hero__frame .sample-badge {
    z-index: 3;
    inset-block-start: auto;
    inset-block-end: 10%;
    inset-inline-start: 3%;
    inset-inline-end: auto;
  }

  .hero__pause {
    position: absolute;
    z-index: 3;
    inset-block-end: 10%;
    inset-inline-end: 3%;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    background: rgb(7 26 58 / 0.7);
    color: var(--washed);
    border: 1px solid rgb(244 242 237 / 0.5);
    cursor: pointer;
    font-size: 0.8rem;
  }

  .hero__pause .i-play,
  .hero__pause[aria-pressed='true'] .i-pause {
    display: none;
  }

  .hero__pause[aria-pressed='true'] .i-play {
    display: block;
  }

  /* Opening sequence: the letterbox opens like a shutter, then title,
     reel and pitch arrive in order. Skipped for reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__title > *,
    .hero__body,
    .hero__frame {
      animation: hero-rise 0.6s var(--ease) both;
    }

    .hero__title > :nth-child(1) { animation-delay: 0.05s; }
    .hero__title > :nth-child(2) { animation-delay: 0.15s; }
    .hero__frame { animation-delay: 0.3s; }
    .hero__body { animation-delay: 0.45s; }

    .hero__frame::before,
    .hero__frame::after {
      animation: shutter 1.1s cubic-bezier(0.7, 0, 0.2, 1) 0.35s both;
    }

    .hero__hud,
    .corner {
      animation: hud-in 0.5s var(--ease) 1.2s both;
    }
  }

  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: none; }
  }

  @keyframes shutter {
    from { height: 50.5%; }
    to { height: 7%; }
  }

  @keyframes hud-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @media (max-width: 600px) {
    /* On phones a 2.39:1 frame gets too thin; use a taller crop. */
    .hero__frame.frame--scope {
      aspect-ratio: 4 / 3;
    }
  }
</style>

<script>
  const video = document.querySelector<HTMLVideoElement>('.hero__video');
  const btn = document.querySelector<HTMLButtonElement>('.hero__pause');
  const tc = document.querySelector<HTMLElement>('.hero__tc');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Running timecode, a small film-set detail. Frozen for reduced motion.
  if (tc && !reduce) {
    let f = 0;
    const pad = (n: number) => String(n).padStart(2, '0');
    setInterval(() => {
      f++;
      const s = Math.floor(f / 25);
      tc.textContent = `TC 00:${pad(Math.floor(s / 60) % 60)}:${pad(s % 60)}:${pad(f % 25)}`;
    }, 40);
  }

  if (video) {
    const setPaused = (paused: boolean) => {
      if (!btn) return;
      btn.setAttribute('aria-pressed', String(paused));
      const label = paused ? btn.dataset.play : btn.dataset.pause;
      btn.querySelector('.visually-hidden')!.textContent = label ?? '';
    };

    // Autoplay only when motion is welcome and the hero is on screen.
    if (!reduce) {
      const io = new IntersectionObserver(([entry]) => {
        if (btn?.getAttribute('aria-pressed') === 'true') return;
        if (entry.isIntersecting) video.play().catch(() => setPaused(true));
        else video.pause();
      });
      io.observe(video);
    } else {
      setPaused(true);
    }

    btn?.addEventListener('click', () => {
      if (video.paused) {
        video.play();
        setPaused(false);
      } else {
        video.pause();
        setPaused(true);
      }
    });
  }
</script>
