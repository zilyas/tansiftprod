---
import type { Service } from '../data/services';
import { serviceUrl } from '../data/services';
import type { Lang } from '../i18n/routes';

interface Props {
  service: Service;
  lang: Lang;
}
const { service, lang } = Astro.props;
---

<article class="service-card" data-reveal>
  <div class="frame frame--wide">
    <img src={service.image} alt="" width="1200" height="1500" loading="lazy" decoding="async" />
  </div>
  <div class="service-card__body">
    <h3><a href={serviceUrl(service, lang)}>{service.name[lang]}</a></h3>
    <p class="muted">{service.line[lang]}</p>
  </div>
</article>

<style>
  .service-card {
    position: relative;
    display: grid;
    background: var(--surface);
    transition: transform 0.25s var(--ease);
  }

  .service-card__body {
    display: grid;
    gap: var(--s-1);
    padding: var(--s-3);
  }

  .service-card h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  /* Whole card is clickable through the heading link. */
  .service-card h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .service-card:hover h3 a,
  .service-card:focus-within h3 a {
    color: var(--accent);
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .service-card:hover {
      transform: translateY(-4px);
    }
  }
</style>
