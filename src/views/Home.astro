---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import Media from '../components/Media.astro';
import ReelHero from '../components/ReelHero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import Proof from '../components/Proof.astro';
import { site } from '../data/site';
import { chapterMedia } from '../data/media';
import { services } from '../data/services';
import { visibleProjects } from '../data/projects';
import { routes, path, type Lang } from '../i18n/routes';
import { t } from '../i18n/ui';
import { faqSchema } from '../lib/schema';
import { pages } from '../lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);

const copy = pages.home[lang];

const featured = visibleProjects.slice(0, 4);
---

<Base lang={lang} title={copy.title} description={copy.description} paths={routes.home} jsonLd={[faqSchema(copy.faq)]}>
  <ReelHero lang={lang} eyebrow={copy.eyebrow} title={copy.h1} lede={copy.lede} />

  <!-- Chapter 1 -->
  <section class="section container" aria-labelledby="ch1">
    <div class="split">
      <div class="stack">
        <SectionHead eyebrow={copy.ch1Label} title={copy.ch1Title} id="ch1" />
        <div class="prose" data-reveal>
          {copy.ch1Body.map((p) => <p>{p}</p>)}
        </div>
        <a class="text-link" href="#ch2">→ {tr('cta.process')}</a>
      </div>
      <div data-reveal>
        <Media
          lang={lang}
          src={chapterMedia.problem.src}
          alt={chapterMedia.problem.alt[lang]}
          width={chapterMedia.problem.width}
          height={chapterMedia.problem.height}
          ratio="portrait"
          tag="Skala du Port · 07:10"
          sample={chapterMedia.problem.placeholder}
          parallax
        />
      </div>
    </div>
  </section>

  <!-- Chapter 2 -->
  <section class="section container band tone-cobalt" aria-labelledby="ch2">
    <SectionHead eyebrow={copy.ch2Label} title={copy.ch2Title} id="ch2" />
    <div class="journey-frame" data-reveal>
      <Media
        lang={lang}
        src={chapterMedia.journey.src}
        alt={chapterMedia.journey.alt[lang]}
        width={chapterMedia.journey.width}
        height={chapterMedia.journey.height}
        ratio="scope"
        tag={lang === 'en' ? 'Beach · 06:45 · before the wind' : 'Plage · 06 h 45 · avant le vent'}
        sample={chapterMedia.journey.placeholder}
        parallax
      />
    </div>
    <ol class="steps">
      {
        copy.steps.map((s, i) => (
          <li class="step" data-reveal>
            <span class="label label--accent">{String(i + 1).padStart(2, '0')} · {s.time}</span>
            <h3>{s.name}</h3>
            <p class="muted">{s.text}</p>
          </li>
        ))
      }
    </ol>
    <a class="text-link" href={path('shoot', lang)}>→ {tr('cta.shoot')}</a>
  </section>

  <!-- Chapter 3 -->
  <section class="section container" aria-labelledby="ch3">
    <SectionHead eyebrow={copy.ch3Label} title={copy.ch3Title} id="ch3">
      <p class="lede muted">{copy.ch3Body}</p>
    </SectionHead>
    <div class="cards">
      {services.map((s, i) => <ServiceCard service={s} lang={lang} featured={i < 2} />)}
    </div>
  </section>

  <section class="section container" aria-labelledby="work">
    <SectionHead eyebrow={copy.workLabel} title={copy.workTitle} id="work" />
    {
      featured.length > 0 ? (
        <div class="work-grid">
          {featured.map((p) => <ProjectCard project={p} lang={lang} />)}
        </div>
      ) : (
        <div class="btn-row work-empty">
          <a class="btn btn--ghost" href={site.portfolio} target="_blank" rel="noopener">{tr('footer.archive')}</a>
          <a class="btn btn--ghost" href={site.instagram} target="_blank" rel="noopener">Instagram {site.instagramHandle}</a>
        </div>
      )
    }
    <a class="text-link" href={path('work', lang)}>→ {tr('cta.work')}</a>
  </section>

  <section class="section container band tone-white" aria-labelledby="why">
    <SectionHead eyebrow={copy.whyLabel} title={copy.whyTitle} id="why" />
    <dl class="why">
      {
        copy.why.map((w) => (
          <div data-reveal>
            <dt>{w.k}</dt>
            <dd class="muted">{w.v}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <Proof lang={lang} />

  <Faq title={tr('faq.title')} items={copy.faq} />

  <CtaBand lang={lang} tone="cobalt" />
</Base>

<style>
  .split {
    display: grid;
    gap: var(--s-5);
    align-items: center;
  }

  @media (min-width: 860px) {
    .split {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .journey-frame {
    margin-block-end: var(--s-4);
  }

  @media (max-width: 600px) {
    .journey-frame :global(.frame--scope) {
      aspect-ratio: 16 / 9;
    }
  }

  .steps {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 2px;
    background: var(--line);
    border: 1px solid var(--line);
    margin-block-end: var(--s-3);
  }

  .step {
    display: grid;
    gap: var(--s-1);
    align-content: start;
    padding: var(--s-3);
    background: var(--bg);
  }

  /* The two business-content services lead; the rest follow smaller. */
  .cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-3);
  }

  @media (min-width: 700px) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .cards {
      grid-template-columns: repeat(6, 1fr);
    }

    .cards > :global(*) {
      grid-column: span 2;
    }

    .cards > :global(*:nth-child(-n + 2)) {
      grid-column: span 3;
    }
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: var(--s-3);
    margin-block-end: var(--s-3);
  }

  .work-empty {
    margin-block-end: var(--s-3);
  }

  .why {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: var(--s-4);
  }

  .why div {
    border-block-start: 3px solid var(--teal-deep);
    padding-block-start: var(--s-2);
    display: grid;
    gap: var(--s-1);
  }

  .why dt {
    font: 700 1.5rem/1.05 var(--display);
    text-transform: uppercase;
  }

  .why dd {
    margin: 0;
  }
</style>
