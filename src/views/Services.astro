---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import { services, serviceUrl } from '../data/services';
import { routes, type Lang } from '../i18n/routes';
import { t } from '../i18n/ui';
import { breadcrumbSchema } from '../lib/schema';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);

const copy = {
  en: {
    title: 'Services | Film, Social Content, Podcasts & Photography | Tansift',
    description:
      'What Tansift Production makes in Essaouira: social media content, video podcasts, photography, brand films, weddings and drone filming.',
    h1: 'What we make',
    lede: 'Six ways we work with brands, businesses and couples in Essaouira. Most projects combine two or three of them in one shoot.',
    more: 'See details',
  },
  fr: {
    title: 'Services | Film, réseaux sociaux, podcasts et photo | Tansift',
    description:
      'Ce que Tansift Production réalise à Essaouira : contenus réseaux sociaux, podcasts vidéo, photographie, films de marque, mariages et tournage drone.',
    h1: 'Ce que nous réalisons',
    lede: 'Six façons de travailler avec les marques, entreprises et couples à Essaouira. La plupart des projets en combinent deux ou trois en un seul tournage.',
    more: 'Voir le détail',
  },
}[lang];
---

<Base
  lang={lang}
  title={copy.title}
  description={copy.description}
  paths={routes.services}
  jsonLd={[
    breadcrumbSchema(Astro.site, [
      { name: tr('breadcrumb.home'), path: routes.home[lang] },
      { name: tr('nav.services'), path: routes.services[lang] },
    ]),
  ]}
>
  <section class="section container band tone-cobalt page-intro">
    <SectionHead eyebrow={tr('nav.services')} title={copy.h1} level="h1">
      <p class="lede muted">{copy.lede}</p>
    </SectionHead>
  </section>

  <section class="section container band-stack">

    <ol class="svc-list">
      {
        services.map((s, i) => (
          <li class={`svc band tone-${['white', 'cobalt', 'white', 'cobalt', 'white', 'cobalt'][i]}`}>
            <div class="frame frame--wide">
              <img src={s.image} alt="" width="1200" height="1500" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
            </div>
            <div class="svc__body">
              <p class="label label--accent">{String(i + 1).padStart(2, '0')}</p>
              <h2>
                <a href={serviceUrl(s, lang)}>{s.name[lang]}</a>
              </h2>
              <p>{s.line[lang]}</p>
              <ul class="svc__tags">
                {s.idealFor[lang].map((x) => <li>{x}</li>)}
              </ul>
              <a class="text-link" href={serviceUrl(s, lang)} aria-hidden="true" tabindex="-1">
                → {copy.more}
              </a>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <CtaBand lang={lang} />
</Base>

<style>
  /* Each service is its own stripe, alternating washed white, cobalt and sand. */
  .svc-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .svc.band {
    padding-block: clamp(3rem, 1.5rem + 5vw, 4rem);
  }

  .svc {
    display: grid;
    gap: var(--s-3);
    align-items: center;
  }

  @media (min-width: 820px) {
    .svc {
      grid-template-columns: 1fr 1fr;
      gap: var(--s-5);
    }

    .svc:nth-child(even) .frame {
      order: 2;
    }
  }

  .svc__body {
    display: grid;
    gap: var(--s-2);
  }

  .svc__body h2 a {
    color: var(--ink);
    text-decoration: none;
  }

  .svc__body h2 a:hover {
    color: var(--accent);
  }

  .svc__tags {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .svc__tags li {
    font: 400 0.75rem/1 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.45rem 0.6rem;
    border: 1px solid var(--line);
    color: var(--muted);
  }
</style>
