---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { categories, projectUrl, visibleProjects, type Project } from '../data/projects';
import { services, serviceUrl } from '../data/services';
import { routes, type Lang } from '../i18n/routes';
import { t } from '../i18n/ui';
import { breadcrumbSchema } from '../lib/schema';

interface Props {
  lang: Lang;
  project: Project;
}
const { lang, project } = Astro.props;
const tr = t(lang);
const story = project.story!;
const paths = { en: projectUrl(project, 'en'), fr: projectUrl(project, 'fr') };
const cat = categories.find((c) => c.id === project.category)!;
const service = services.find((s) => s.id === project.category);
const more = visibleProjects.filter((p) => p.slug !== project.slug).slice(0, 3);

const copy = {
  en: { brief: 'The brief', approach: 'The approach', result: 'The result', delivered: 'Delivered', credits: 'Credits', more: 'More work', service: 'Related service', watch: 'Watch the film' },
  fr: { brief: 'Le brief', approach: 'L’approche', result: 'Le résultat', delivered: 'Livré', credits: 'Crédits', more: 'Autres réalisations', service: 'Service associé', watch: 'Voir le film' },
}[lang];

const title = `${project.title[lang]} — ${cat.label[lang]}, Essaouira | Tansift`;
const video = project.video
  ? {
      '@context': 'https://schema.org',
      '@type': 'VideoObject',
      name: project.title[lang],
      description: project.summary[lang],
      thumbnailUrl: new URL(project.cover, Astro.site).href,
      contentUrl: new URL(project.video, Astro.site).href,
      ...(project.year ? { uploadDate: `${project.year}-01-01` } : {}),
    }
  : null;
---

<Base
  lang={lang}
  title={title}
  description={project.summary[lang]}
  paths={paths}
  noindex={project.sample}
  jsonLd={[
    breadcrumbSchema(Astro.site, [
      { name: tr('breadcrumb.home'), path: routes.home[lang] },
      { name: tr('nav.work'), path: routes.work[lang] },
      { name: project.title[lang], path: paths[lang] },
    ]),
    ...(video ? [video] : []),
  ]}
>
  <article>
    <header class="section container cs-head band tone-cobalt">
      <nav class="crumbs label" aria-label="Breadcrumb">
        <a href={routes.home[lang]}>{tr('breadcrumb.home')}</a>
        <span aria-hidden="true">/</span>
        <a href={routes.work[lang]}>{tr('nav.work')}</a>
      </nav>
      <p class="label label--accent">{cat.label[lang]} · {project.place}{project.year && ` · ${project.year}`}</p>
      <h1>{project.title[lang]}</h1>
      <p class="lede">{project.summary[lang]}</p>
      <p class="label">{project.client}</p>
    </header>

    <div class="container">
      <figure class="frame frame--scope cs-cover">
        {
          project.video ? (
            <video src={project.video} poster={project.cover} controls preload="none" playsinline aria-label={project.title[lang]} />
          ) : (
            <img src={project.cover} alt={project.title[lang]} width="1920" height="804" fetchpriority="high" decoding="async" />
          )
        }
        {project.sample && <span class="sample-badge">{tr('media.sample')}</span>}
      </figure>
    </div>

    <section class="section container cs-story">
      <div class="cs-text">
        <div data-reveal>
          <h2>{copy.brief}</h2>
          <p>{story.brief[lang]}</p>
        </div>
        <div data-reveal>
          <h2>{copy.approach}</h2>
          <p>{story.approach[lang]}</p>
        </div>
        <div data-reveal>
          <h2>{copy.result}</h2>
          <p>{story.result[lang]}</p>
        </div>
      </div>
      <aside class="cs-facts">
        <div>
          <p class="label">{copy.delivered}</p>
          <ul>{story.deliverables[lang].map((d) => <li>{d}</li>)}</ul>
        </div>
        {
          story.credits && (
            <div>
              <p class="label">{copy.credits}</p>
              <dl>
                {story.credits.map((c) => (
                  <>
                    <dt>{c.role[lang]}</dt>
                    <dd>{c.name}</dd>
                  </>
                ))}
              </dl>
            </div>
          )
        }
        {
          service && (
            <div>
              <p class="label">{copy.service}</p>
              <a class="text-link" href={serviceUrl(service, lang)}>→ {service.name[lang]}</a>
            </div>
          )
        }
        {project.link && <a class="btn btn--ghost" href={project.link} target="_blank" rel="noopener">{copy.watch}</a>}
      </aside>
    </section>

    {
      story.gallery && story.gallery.length > 0 && (
        <section class="container cs-gallery" aria-label="Gallery">
          {story.gallery.map((src) => (
            <figure class="frame frame--wide" data-reveal>
              <img src={src} alt="" width="1600" height="900" loading="lazy" decoding="async" />
            </figure>
          ))}
        </section>
      )
    }
  </article>

  {
    more.length > 0 && (
      <section class="section container band tone-cobalt" aria-labelledby="more-work">
        <div class="section-head">
          <p class="label"><span class="label--accent">{tr('nav.work')}</span></p>
          <h2 id="more-work">{copy.more}</h2>
        </div>
        <div class="more">
          {more.map((p) => <ProjectCard project={p} lang={lang} />)}
        </div>
      </section>
    )
  }

  <CtaBand lang={lang} />
</Base>

<style>
  .cs-head {
    display: grid;
    gap: var(--s-2);
    padding-block: var(--s-5) var(--s-4);
  }

  .cs-head h1 {
    font-size: clamp(2.6rem, 9vw, 6.5rem);
    max-width: 16ch;
  }

  .crumbs {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .crumbs a {
    color: var(--muted);
    text-decoration: none;
    min-height: 32px;
    display: inline-flex;
    align-items: center;
  }

  @media (max-width: 600px) {
    .cs-cover.frame--scope {
      aspect-ratio: 4 / 3;
    }
  }

  .cs-story {
    display: grid;
    gap: var(--s-5);
  }

  @media (min-width: 900px) {
    .cs-story {
      grid-template-columns: 1.6fr 1fr;
      align-items: start;
    }

    .cs-facts {
      position: sticky;
      top: calc(var(--header-h) + var(--s-3));
    }
  }

  .cs-text {
    display: grid;
    gap: var(--s-5);
    max-width: 66ch;
  }

  .cs-text div {
    display: grid;
    gap: var(--s-2);
  }

  .cs-text h2 {
    font-size: clamp(1.6rem, 3.6vw, 2.4rem);
  }

  .cs-facts {
    display: grid;
    gap: var(--s-4);
    padding: var(--s-3);
    background: var(--surface);
    align-content: start;
  }

  .cs-facts div {
    display: grid;
    gap: var(--s-1);
  }

  .cs-facts ul {
    padding-inline-start: 1.1rem;
    display: grid;
    gap: 0.3rem;
  }

  .cs-facts dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.3rem var(--s-2);
    margin: 0;
  }

  .cs-facts dt {
    color: var(--muted);
  }

  .cs-facts dd {
    margin: 0;
  }

  .cs-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr));
    gap: var(--s-3);
    margin-block-start: var(--s-6);
  }

  .more {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: var(--s-3);
  }
</style>
