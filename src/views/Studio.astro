---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import Media from '../components/Media.astro';
import CtaBand from '../components/CtaBand.astro';
import { studioMedia } from '../data/media';
import { site } from '../data/site';
import { routes, type Lang } from '../i18n/routes';
import { t } from '../i18n/ui';
import { breadcrumbSchema } from '../lib/schema';
import { pages } from '../lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);

// TODO: confirm the story behind the name with the Tansift team, and add
// crew names, roles and credits in `crew` below.
const copy = pages.studio[lang];

// Crew cards appear only once names are added.
const crew: { name: string; role: Record<Lang, string>; photo?: string }[] = [];
---

<Base
  lang={lang}
  title={copy.title}
  description={copy.description}
  paths={routes.studio}
  jsonLd={[
    breadcrumbSchema(Astro.site, [
      { name: tr('breadcrumb.home'), path: routes.home[lang] },
      { name: tr('nav.studio'), path: routes.studio[lang] },
    ]),
  ]}
>
  <section class="section container band tone-cobalt page-intro">
    <SectionHead eyebrow={copy.eyebrow} title={copy.h1} level="h1">
      <p class="lede">{copy.lede}</p>
    </SectionHead>
  </section>

  <section class="section container">
    <div data-reveal>
      <Media
        lang={lang}
        src={studioMedia.team.src}
        alt={studioMedia.team.alt[lang]}
        width={studioMedia.team.width}
        height={studioMedia.team.height}
        ratio="scope"
        tag="Essaouira"
        sample={studioMedia.team.placeholder}
        eager
        parallax
      />
    </div>
  </section>

  <section class="section container band tone-cobalt" aria-labelledby="name">
    <div class="name-block" data-reveal>
      <p class="label label--accent">{copy.nameLabel}</p>
      <h2 id="name">Tansift</h2>
      <p class="lede">{copy.name}</p>
    </div>
  </section>

  <section class="section container" aria-labelledby="how">
    <SectionHead eyebrow={copy.eyebrow} title={copy.howLabel} id="how" />
    <dl class="how">
      {
        copy.how.map((h) => (
          <div data-reveal>
            <dt>{h.k}</dt>
            <dd class="muted">{h.v}</dd>
          </div>
        ))
      }
    </dl>
    <p class="label langs">{copy.langLabel}: <span class="label--accent">{copy.langs}</span></p>
  </section>

  {
    crew.length > 0 && (
      <section class="section container" aria-labelledby="crew">
        <SectionHead eyebrow="Crew" title={lang === 'en' ? 'The crew' : 'L’équipe'} id="crew" />
        <ul class="crew">
          {crew.map((c) => (
            <li>
              {c.photo && <img src={c.photo} alt={c.name} width="600" height="750" loading="lazy" />}
              <h3>{c.name}</h3>
              <p class="muted">{c.role[lang]}</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="section container" aria-labelledby="follow">
    <div class="follow" data-reveal>
      <h2 id="follow">{tr('footer.follow')}</h2>
      <div class="btn-row">
        <a class="btn btn--ghost" href={site.instagram} target="_blank" rel="noopener">Instagram {site.instagramHandle}</a>
        <a class="btn btn--ghost" href={site.portfolio} target="_blank" rel="noopener">{tr('footer.archive')}</a>
      </div>
    </div>
  </section>

  <CtaBand lang={lang} />
</Base>

<style>
  .name-block {
    display: grid;
    gap: var(--s-3);
    padding: clamp(1.5rem, 5vw, 3.5rem);
    background: var(--surface);
    border-inline-start: 4px solid var(--accent);
  }

  .name-block h2 {
    font-size: clamp(3rem, 12vw, 8rem);
  }

  .how {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: var(--s-4);
  }

  .how div {
    border-block-start: 3px solid var(--teal-deep);
    padding-block-start: var(--s-2);
    display: grid;
    gap: var(--s-1);
  }

  .how dt {
    font: 700 1.5rem/1.05 var(--display);
    text-transform: uppercase;
  }

  .how dd {
    margin: 0;
  }

  .langs {
    margin-block-start: var(--s-4);
  }

  .crew {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    gap: var(--s-3);
  }

  .follow {
    display: grid;
    gap: var(--s-3);
  }
</style>
