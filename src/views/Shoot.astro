---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { articles, articleUrl } from '../data/journal';
import { routes, type Lang } from '../i18n/routes';
import { t } from '../i18n/ui';
import { breadcrumbSchema, faqSchema } from '../lib/schema';
import { pages } from '../lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tr = t(lang);

const copy = pages.shoot[lang];

// Rough wind strength by month (0 calmer, 1 building, 2 strongest), from local kitesurf guides.
const wind = [0, 0, 0, 1, 1, 2, 2, 2, 2, 1, 0, 0];
---

<Base
  lang={lang}
  title={copy.title}
  description={copy.description}
  paths={routes.shoot}
  jsonLd={[
    faqSchema(copy.faq),
    breadcrumbSchema(Astro.site, [
      { name: tr('breadcrumb.home'), path: routes.home[lang] },
      { name: tr('nav.shoot'), path: routes.shoot[lang] },
    ]),
  ]}
>
  <section class="section container band tone-cobalt page-intro">
    <SectionHead eyebrow={copy.eyebrow} kicker="31.51° N · 9.77° W" title={copy.h1} level="h1">
      <p class="lede">{copy.lede}</p>
      <div class="btn-row">
        <a class="btn" href={`${routes.contact[lang]}?type=production`}>{tr('nav.cta')}</a>
      </div>
    </SectionHead>
  </section>

  <section class="section container" aria-labelledby="provide">
    <SectionHead eyebrow={copy.provideLabel} title={copy.provideTitle} id="provide" />
    <dl class="provide">
      {
        copy.provide.map((p) => (
          <div data-reveal>
            <dt>{p.k}</dt>
            <dd class="muted">{p.v}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="section container" aria-labelledby="locations">
    <SectionHead eyebrow={copy.locLabel} title={copy.locTitle} id="locations" />
    <ol class="locs">
      {
        copy.locations.map((l, i) => (
          <li data-reveal>
            <span class="label label--accent">{String(i + 1).padStart(2, '0')}</span>
            <h3>{l.name}</h3>
            <p class="muted">{l.note}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section container band tone-cobalt" aria-labelledby="wind">
    <SectionHead eyebrow={copy.windLabel} title={copy.windTitle} id="wind">
      <p class="muted">{copy.windNote}</p>
    </SectionHead>
    <div>
      <ol class="wind" aria-label={copy.windTitle}>
        {
          copy.months.map((m, i) => (
            <li class={`w${wind[i]}`}>
              <span>{m}</span>
              <span class="visually-hidden">: {copy.legend[wind[i]]}</span>
            </li>
          ))
        }
      </ol>
    </div>
    <p class="legend label">
      {copy.legend.map((l, i) => <span><i class={`w${i}`} aria-hidden="true"></i>{l}</span>)}
    </p>
  </section>

  <section class="section container" aria-labelledby="screen">
    <div class="screen" data-reveal>
      <p class="label label--accent">{copy.screenLabel}</p>
      <h2 id="screen">{copy.screenTitle}</h2>
      <p class="lede">{copy.screen}</p>
    </div>
  </section>

  <section class="section container" aria-labelledby="guides">
    <SectionHead eyebrow={tr('nav.journal')} title={copy.guides} id="guides" />
    <ul class="guides">
      {
        articles.map((a) => (
          <li data-reveal>
            <a href={articleUrl(a, lang)}>
              <span class="h3">{a.title[lang]}</span>
              <span class="muted">{a.description[lang]}</span>
              <span class="text-link">→ {tr('readMore')}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <Faq title={tr('faq.title')} items={copy.faq} />

  <CtaBand lang={lang} tone="cobalt" />
</Base>

<style>
  .provide {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: var(--s-4) var(--s-3);
  }

  .provide div {
    border-block-start: 3px solid var(--teal-deep);
    padding-block-start: var(--s-2);
    display: grid;
    gap: var(--s-1);
  }

  .provide dt {
    font: 700 1.5rem/1.05 var(--display);
    text-transform: uppercase;
  }

  .provide dd {
    margin: 0;
  }

  .locs {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 2px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .locs li {
    background: var(--bg);
    padding: var(--s-3);
    display: grid;
    gap: var(--s-1);
    align-content: start;
  }

  .wind {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 3px;
  }

  @media (min-width: 640px) {
    .wind {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
  }

  .wind li {
    position: relative;
    padding: 1.4rem 0.2rem;
    text-align: center;
    font: 400 0.75rem/1 var(--mono);
  }

  .w0 {
    background: var(--surface-2);
  }

  .w1 {
    background: color-mix(in srgb, var(--teal-deep) 45%, var(--surface-2));
  }

  .w2 {
    background: var(--teal-deep);
    color: var(--washed);
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-block-start: var(--s-2);
  }

  .legend span {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
  }

  .legend i {
    width: 14px;
    height: 14px;
    display: inline-block;
  }

  .screen {
    display: grid;
    gap: var(--s-3);
    padding: clamp(1.5rem, 5vw, 3.5rem);
    background: var(--surface);
    border-inline-start: 4px solid var(--accent);
  }

  .guides {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: var(--s-3);
  }

  .guides a {
    display: grid;
    gap: var(--s-1);
    height: 100%;
    padding: var(--s-3);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
  }

  .guides a:hover .h3 {
    color: var(--accent);
  }

  .h3 {
    font: 600 1.45rem/1.05 var(--display);
    text-transform: uppercase;
  }
</style>
